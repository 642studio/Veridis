OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

WAKE_PHRASE=oye veridis
WAKE_COOLDOWN_MS=1500
TURN_COOLDOWN_MS=1200
KEEP_SNAPSHOTS=false

CAMERA_DEVICE=/dev/video0
CAMERA_FORMAT=v4l2
MIC_DEVICE=default
MIC_INPUT_FORMAT=alsa
SPEAKER_SAMPLE_RATE=24000

OPENCLAW_CLI=openclaw
OPENCLAW_AGENT_ID=main
OPENCLAW_SESSION_KEY=agent:main:main
OPENCLAW_TIMEOUT_MS=45000

VERIDIS_CORE_URL=http://127.0.0.1:3001
BRIDGE_PORT=3400
LOG_LEVEL=info
